---
import Layout from "../layouts/Layout.astro";
import GscInfographicReport, { faq, PATH, HERO, FUNNEL, SAMPLE } from "../components/pages/GscInfographicReport.tsx";
import { faqLd, galleryLd } from "../lib/schema";

const title = "GSC Infographic Report: Search Console Data as One Image";
const description =
  "Turn a Google Search Console export into an infographic report: which tab feeds which visual, what each metric counts, and five data quirks to know.";
---
<Layout
  title={title}
  description={description}
  path={PATH}
  image={{ src: HERO.png, w: HERO.w, h: HERO.h, alt: HERO.alt }}
  breadcrumb={[{ name: "Home", path: "/" }, { name: "SEO Infographics", path: "/seo-infographics/" }, { name: "GSC Infographic Report", path: PATH }]}
  jsonLd={[galleryLd({ path: PATH, name: title, description, graphics: [HERO, FUNNEL, SAMPLE], type: "WebPage" }), faqLd(faq)]}
>
  <GscInfographicReport />
</Layout>
