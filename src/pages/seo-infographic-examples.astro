---
import Layout from "../layouts/Layout.astro";
import SeoInfographicExamples, { faq, PATH, HERO } from "../components/pages/SeoInfographicExamples.tsx";
import { GRAPHICS, EXAMPLES } from "../lib/graphics/catalog.mjs";
import { faqLd, galleryLd } from "../lib/schema";

const title = "SEO Infographic Examples: 10 Annotated Designs (Free PNG)";
const description =
  "Ten annotated SEO infographic examples from Search Console-style data — growth, recovery, keyword wins, CTR fixes and more. Free PNG downloads.";
---
<Layout
  title={title}
  description={description}
  path={PATH}
  image={{ src: HERO.png, w: HERO.w, h: HERO.h, alt: HERO.alt }}
  breadcrumb={[{ name: "Home", path: "/" }, { name: "SEO Infographics", path: "/seo-infographics/" }, { name: "Examples", path: PATH }]}
  jsonLd={[galleryLd({ path: PATH, name: title, description, graphics: EXAMPLES.map((e) => GRAPHICS[e.id]), type: "ImageGallery" }), faqLd(faq)]}
>
  <SeoInfographicExamples />
</Layout>
