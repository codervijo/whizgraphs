---
import Layout from "../layouts/Layout.astro";
import SeoInfographics, { faq, PATH, HERO } from "../components/pages/SeoInfographics.tsx";
import { GRAPHICS, CORE_IDS } from "../lib/graphics/catalog.mjs";
import { faqLd, galleryLd } from "../lib/schema";

const title = "SEO Infographics: 5 Free Templates + How to Make One";
const description =
  "Five free SEO infographic templates built from Search Console data — traffic, top pages, keyword wins and more — plus how to publish infographics for SEO.";
---
<Layout
  title={title}
  description={description}
  path={PATH}
  image={{ src: HERO.png, w: HERO.w, h: HERO.h, alt: HERO.alt }}
  breadcrumb={[{ name: "Home", path: "/" }, { name: "SEO Infographics", path: PATH }]}
  jsonLd={[
    galleryLd({ path: PATH, name: title, description, graphics: [...CORE_IDS, "seo-infographic-anatomy"].map((id) => GRAPHICS[id]) }),
    faqLd(faq),
  ]}
>
  <SeoInfographics />
</Layout>
