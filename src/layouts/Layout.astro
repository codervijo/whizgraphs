---
// src/layouts/Layout.astro — shared chrome + head for ported WhizGraphs pages.
import "../styles/global.css";
import Header from "../components/Header.tsx";
import Footer from "../components/Footer.tsx";

const site = "https://whizgraphs.com";
const {
  title = "WhizGraphs",
  description = "WhizGraphs converts Search Console data into clean visual SEO reports.",
  path = "/",
  breadcrumb = [],
} = Astro.props;
// Standardize on the with-slash form: it is what the static build serves (200)
// and what the sitemap emits. A no-slash canonical would point at a 308 redirect.
const normalizedPath = path.endsWith("/") ? path : `${path}/`;
const canonical = new URL(normalizedPath, site).href;

// Optional BreadcrumbList JSON-LD: pages pass a [{ name, path }] trail (Home → …).
const breadcrumbLd =
  breadcrumb.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumb.map((b, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: b.name,
          item: new URL(b.path.endsWith("/") ? b.path : `${b.path}/`, site).href,
        })),
      }
    : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="WhizGraphs" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {breadcrumbLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    )}

    <!-- Prevent theme flash: apply persisted/system theme before paint -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("whizgraphs-theme") || "system";
          var resolved =
            theme === "system"
              ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
              : theme;
          if (resolved === "dark") document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="flex min-h-screen flex-col bg-background">
      <Header client:idle />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
